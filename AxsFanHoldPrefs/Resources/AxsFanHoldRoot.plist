<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key><string>扇形菜单长按</string>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>基本设置</string>
            <key>footerText</key><string>为 TrollOpen 扇形菜单里的“快捷指令”条目补上长按不松手即可运行的能力。应用和内置动作不受影响。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>启用插件</string>
            <key>key</key><string>enabled</string>
            <key>defaults</key><string>com.axs.fanhold</string>
            <key>default</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsFanHoldSliderCell</string>
            <key>label</key><string>长按时长（秒）</string>
            <key>key</key><string>holdDuration</string>
            <key>defaults</key><string>com.axs.fanhold</string>
            <key>default</key><real>0.4</real>
            <key>min</key><real>0.1</real>
            <key>max</key><real>2.0</real>
        </dict>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>排查</string>
            <key>footerText</key><string>开启后会把插件运行情况写到 /var/mobile/Library/Logs/AxsFanHold.log，用于定位问题。日常使用可关闭。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>调试日志</string>
            <key>key</key><string>debugLog</string>
            <key>defaults</key><string>com.axs.fanhold</string>
            <key>default</key><false/>
        </dict>
    </array>
</dict>
</plist>
